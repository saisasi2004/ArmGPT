# ArmGPT configuration - copy to `.env` and edit, or just export these in your
# shell. Every value here is the default; nothing needs setting to run locally.
#
# Note: ArmGPT reads plain environment variables, it does not parse `.env`
# itself. Either export them, or use a runner that loads .env for you:
#
#   PowerShell   $env:ARMGPT_CAMERA_INDEX = "2"; python app.py
#   bash/zsh     ARMGPT_CAMERA_INDEX=2 python app.py

# --- LLM (Ollama) -----------------------------------------------------------
ARMGPT_OLLAMA_HOST=http://localhost:11434
# Preference list; the first tag actually pulled wins.
ARMGPT_LLM_MODELS=qwen3.5:4b,qwen3.5:latest,qwen3:4b,qwen3:8b
# Seconds to keep the model in RAM. -1 = forever (no reload penalty, but it
# holds ~3.4GB). Use "30m" or "5m" on a memory-tight machine.
ARMGPT_LLM_KEEP_ALIVE=-1
# Load the model at startup so the first command isn't the one that pays.
ARMGPT_LLM_WARMUP=1
# Qwen3 hybrid thinking. Off: the arm blocks on this call.
ARMGPT_LLM_THINK=0
ARMGPT_LLM_TIMEOUT=120
# Context window. Also a memory cap - see config.py.
ARMGPT_LLM_NUM_CTX=4096

# --- Camera -----------------------------------------------------------------
# Starting guess only; the UI's source picker remembers your real choice.
ARMGPT_CAMERA_INDEX=0
ARMGPT_CAMERA_WIDTH=1280
ARMGPT_CAMERA_HEIGHT=720
# Set to 1 to get OpenCV's raw videoio chatter back when debugging capture.
ARMGPT_CV_VERBOSE=0

# --- Robot TCP --------------------------------------------------------------
# server = ArmGPT listens, the controller connects in.
# client = ArmGPT dials out to a listening controller.
ARMGPT_ROBOT_MODE=server
ARMGPT_ROBOT_HOST=127.0.0.1
ARMGPT_ROBOT_PORT=5000
ARMGPT_ROBOT_TIMEOUT=5
# KEEP THIS AT 1 until a real controller is on the other end.
ARMGPT_ROBOT_DRY_RUN=1

# --- Safety -----------------------------------------------------------------
# Hand-detection interlock. A convenience check, NOT a safety-rated system.
ARMGPT_SAFETY_CHECK=1

# --- MongoDB (optional) -----------------------------------------------------
# Without it, history is kept in memory for the life of the process.
ARMGPT_MONGO_URI=mongodb://127.0.0.1:27017
ARMGPT_MONGO_DB=armgpt
ARMGPT_MONGO_TIMEOUT_MS=1500

# --- Web server -------------------------------------------------------------
ARMGPT_HOST=127.0.0.1
ARMGPT_PORT=5050
ARMGPT_DEBUG=0
