# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.so

# ─── Virtual environments ────────────────────────────────────────────
.venv
venv/
env/
ENV/

# ─── Model weights (auto-download on first use) ──────────────────────
# ultralytics fetches yolov8n.pt automatically if it's missing, so it
# doesn't need to live in the repo. Delete these lines if you'd rather
# vendor the weights for offline installs.
yolov8n.pt
*.pt
*.onnx
*.engine

# ─── Local config / secrets ──────────────────────────────────────────
.env
.env.*
# ...but the annotated template IS meant to be committed. (gitignore has no
# trailing comments - a "# note" here would become part of the pattern.)
!.env.example
*.local

# ─── Runtime + diagnostics ───────────────────────────────────────────
*.log
mongo_diag.py
mongo_diag_out.txt
scratch_cam/
captures/
snapshots/

# ─── Editor / IDE ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.mount_refresh
